rules_version = '2';

// Security rules for Santa App. There is no backend: the browser talks to
// Firestore directly, so these rules are the only thing standing between a
// user and other people's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Everything the current client does needs any signed-in user to be able to
    // read and rewrite whole draw documents. The following commits tighten this.
    match /draws/{drawId} {
      allow read, write: if signedIn();
    }

    match /appData/stats {
      allow read, write: if signedIn();
    }

    match /messages/{messageId} {
      allow read, create: if signedIn();
    }
  }
}
