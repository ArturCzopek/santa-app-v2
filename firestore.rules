rules_version = '2';

// Security rules for Santa App. There is no backend: the browser talks to
// Firestore directly, so these rules are the only thing standing between a
// user and other people's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function drawPath(drawId) {
      return /databases/$(database)/documents/draws/$(drawId);
    }

    function invitePath(drawId) {
      return /databases/$(database)/documents/draws/$(drawId)/invite/link;
    }

    function joinKeyPath(drawId, joinKey) {
      return /databases/$(database)/documents/draws/$(drawId)/joinKeys/$(joinKey);
    }

    // The owner, either creating the draw in this batch or before the draw.
    function isOwnerBeforeDraw(drawId) {
      return (!exists(drawPath(drawId))
          && getAfter(drawPath(drawId)).data.ownerUuid == request.auth.uid)
        || (get(drawPath(drawId)).data.ownerUuid == request.auth.uid
          && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW');
    }

    // The owner deletes the whole draw (before the draw) in this batch; the
    // subcollections go in the same batch as the draw document.
    function isDeletingDraw(drawId) {
      return get(drawPath(drawId)).data.ownerUuid == request.auth.uid
        && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
        && !existsAfter(drawPath(drawId));
    }

    function letterPath(drawId, uid) {
      return /databases/$(database)/documents/draws/$(drawId)/letters/$(uid);
    }

    function participantPath(drawId, uid) {
      return /databases/$(database)/documents/draws/$(drawId)/participants/$(uid);
    }

    // Names and photos shown to other participants must be the user's own
    // Google profile data, with the same fallbacks the client uses.
    function tokenName() {
      return request.auth.token.get('name', 'Unknown User');
    }

    function tokenPicture() {
      return request.auth.token.get('picture', '');
    }

    function isString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    // Fields the owner fills in; the event ones are optional (older draws
    // do not have them).
    function hasValidDetails(d) {
      return isString(d.drawName, 80) && d.drawName.size() > 0
        && isString(d.description, 1000)
        && (d.budget is int || d.budget is float) && d.budget > 0 && d.budget <= 1000000
        && d.currency in ['PLN', 'EUR', 'USD', 'GBP']
        && isString(d.get('eventDate', ''), 10)
        && d.get('eventDate', '').matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && isString(d.get('eventPlace', ''), 200);
    }

    function isValidNewDraw(drawId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'createdDate', 'ownerUuid', 'ownerName', 'ownerPhotoUrl', 'budget',
          'currency', 'drawName', 'description', 'participantUuids', 'status',
          'drawDate', 'eventDate', 'eventPlace'
        ])
        && d.ownerUuid == request.auth.uid
        && d.participantUuids == [request.auth.uid]
        && d.status == 'WAITING_FOR_DRAW'
        && d.drawDate == null
        && d.createdDate == request.time
        && hasValidDetails(d)
        && d.ownerName == tokenName()
        && d.ownerPhotoUrl == tokenPicture()
        && existsAfter(participantPath(drawId, request.auth.uid));
    }

    // Owner moves the draw to DRAWED; assignments are written in the same batch.
    function isStartingDraw() {
      return resource.data.ownerUuid == request.auth.uid
        && resource.data.status == 'WAITING_FOR_DRAW'
        && resource.data.participantUuids.size() >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'drawDate'])
        && request.resource.data.status == 'DRAWED'
        && request.resource.data.drawDate == request.time;
    }

    // Owner changes the draw's own fields; after the draw nothing changes.
    function isEditingDetails() {
      return resource.data.ownerUuid == request.auth.uid
        && resource.data.status == 'WAITING_FOR_DRAW'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'drawName', 'description', 'budget', 'currency', 'eventDate', 'eventPlace'
        ])
        && hasValidDetails(request.resource.data);
    }

    // A user adds exactly themselves to participantUuids, together with their
    // own participant document.
    function isJoining(drawId) {
      return resource.data.status == 'WAITING_FOR_DRAW'
        && !(request.auth.uid in resource.data.participantUuids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUuids'])
        && request.resource.data.participantUuids == resource.data.participantUuids.concat([request.auth.uid])
        && request.resource.data.participantUuids.size() <= 100
        && existsAfter(participantPath(drawId, request.auth.uid));
    }

    // A participant (not the owner) takes themselves out before the draw,
    // together with their participant document.
    function isLeaving(drawId) {
      return resource.data.status == 'WAITING_FOR_DRAW'
        && request.auth.uid in resource.data.participantUuids
        && request.auth.uid != resource.data.ownerUuid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUuids'])
        && request.resource.data.participantUuids == resource.data.participantUuids.removeAll([request.auth.uid])
        && !existsAfter(participantPath(drawId, request.auth.uid));
    }

    // The owner takes one other person out before the draw (someone who
    // joined by mistake, or will not take part after all), together with
    // their participant document.
    function isRemovingParticipant(drawId) {
      let removed = resource.data.participantUuids.removeAll(request.resource.data.participantUuids);
      return resource.data.ownerUuid == request.auth.uid
        && resource.data.status == 'WAITING_FOR_DRAW'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUuids'])
        && removed.size() == 1
        && !(request.auth.uid in removed)
        && request.resource.data.participantUuids == resource.data.participantUuids.removeAll(removed)
        && !existsAfter(participantPath(drawId, removed[0]));
    }

    // The documents that go with a person the owner takes out: that person
    // is off the list after this batch.
    function isOwnerRemoving(drawId, uid) {
      return get(drawPath(drawId)).data.ownerUuid == request.auth.uid
        && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
        && uid != request.auth.uid
        && !(uid in getAfter(drawPath(drawId)).data.participantUuids);
    }

    function isValidNewParticipant(uid) {
      let p = request.resource.data;
      return p.keys().hasOnly(['userName', 'userUuid', 'userPhotoUrl', 'entryDate', 'hasWish', 'joinKey'])
        && p.userUuid == uid
        && p.entryDate == request.time
        && p.hasWish == false
        && p.userName == tokenName()
        && p.userPhotoUrl == tokenPicture();
    }

    match /draws/{drawId} {
      // The draw document holds nothing secret: anyone signed in who knows the
      // id may open it (join page). Listing only returns the user's own draws.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.participantUuids;
      allow create: if signedIn() && isValidNewDraw(drawId);
      allow update: if signedIn()
        && (isStartingDraw() || isJoining(drawId) || isEditingDetails()
          || isLeaving(drawId) || isRemovingParticipant(drawId));
      allow delete: if signedIn()
        && resource.data.ownerUuid == request.auth.uid
        && resource.data.status == 'WAITING_FOR_DRAW';

      match /participants/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(drawPath(drawId)).data.participantUuids;

        // Either the owner creating the draw, or a user joining it with the
        // right password (joinKey must name an existing joinKeys document).
        // The joinKey stays visible to co-participants, who know the password
        // anyway.
        allow create: if signedIn()
          && request.auth.uid == uid
          && isValidNewParticipant(uid)
          && (
            (!exists(drawPath(drawId))
              && getAfter(drawPath(drawId)).data.ownerUuid == uid)
            || (get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
              && !(uid in get(drawPath(drawId)).data.participantUuids)
              && uid in getAfter(drawPath(drawId)).data.participantUuids
              && request.resource.data.joinKey is string
              && exists(/databases/$(database)/documents/draws/$(drawId)/joinKeys/$(request.resource.data.joinKey)))
          );

        // Users only mark whether they wrote their letter, in the same batch
        // as the letter itself (see letters below), so the mark is true;
        // like the letter, only before the draw.
        allow update: if signedIn()
          && request.auth.uid == uid
          && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasWish'])
          && request.resource.data.hasWish == (getAfter(letterPath(drawId, uid)).data.wish.size() > 0);

        // Leaving the draw, the owner taking someone out, or the owner
        // deleting the draw.
        allow delete: if signedIn()
          && (isDeletingDraw(drawId)
            || isOwnerRemoving(drawId, uid)
            || (request.auth.uid == uid
              && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
              && uid != get(drawPath(drawId)).data.ownerUuid
              && !(uid in getAfter(drawPath(drawId)).data.participantUuids)));
      }

      // Join check: the document id is the hash of a secret that lets people
      // in - the password, or the key carried by the invite link. The
      // password one is created together with the draw, the link one with
      // the invite document. Only the owner may read them: to confirm
      // starting the draw, and to find them all when deleting the draw.
      // Before the draw the owner may add keys and remove any key except
      // the current invite link's: a new link retires the old one's key,
      // and a new password replaces the old password's key.
      match /joinKeys/{joinKey} {
        allow read: if signedIn()
          && get(drawPath(drawId)).data.ownerUuid == request.auth.uid;

        allow create: if signedIn()
          && joinKey.matches('^[0-9a-f]{64}$')
          && request.resource.data.keys().hasOnly(['createdDate'])
          && isOwnerBeforeDraw(drawId);

        allow delete: if signedIn()
          && (isDeletingDraw(drawId)
            || (isOwnerBeforeDraw(drawId)
              && (!existsAfter(invitePath(drawId))
                || getAfter(invitePath(drawId)).data.joinKey != joinKey)));
      }

      // The invite link's key, in readable form so that participants can
      // share the link again. Knowing it is the same as knowing the password.
      match /invite/{inviteId} {
        allow get: if signedIn()
          && request.auth.uid in get(drawPath(drawId)).data.participantUuids;

        allow create, update: if signedIn()
          && inviteId == 'link'
          && isOwnerBeforeDraw(drawId)
          && request.resource.data.keys().hasOnly(['key', 'joinKey', 'createdDate'])
          && request.resource.data.key is string
          && request.resource.data.key.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.joinKey is string
          && request.resource.data.joinKey.matches('^[0-9a-f]{64}$')
          && request.resource.data.createdDate == request.time
          && existsAfter(joinKeyPath(drawId, request.resource.data.joinKey));

        allow delete: if signedIn() && isDeletingDraw(drawId);
      }

      // Letters to Santa. Only their author reads them, and after the draw
      // the one person whose result is the author - nobody else, not even
      // the owner or the other participants.
      match /letters/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid
            || (get(drawPath(drawId)).data.status == 'DRAWED'
              && get(/databases/$(database)/documents/draws/$(drawId)/assignments/$(request.auth.uid)).data.toUuid == uid));

        // Written and changed only before the draw: the Santa reads the
        // letter as it was when the pairs were drawn.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in get(drawPath(drawId)).data.participantUuids
          && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
          && request.resource.data.keys().hasOnly(['wish'])
          && isString(request.resource.data.wish, 2000)
          && getAfter(participantPath(drawId, uid)).data.hasWish == (request.resource.data.wish.size() > 0);

        // Leaving the draw, the owner taking someone out (the letter goes
        // unread), or the owner deleting the draw.
        allow delete: if signedIn()
          && (isDeletingDraw(drawId)
            || isOwnerRemoving(drawId, uid)
            || (request.auth.uid == uid
              && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
              && !(uid in getAfter(drawPath(drawId)).data.participantUuids)));
      }

      // Pairs of participants who must not draw each other (e.g. a couple).
      // Only the owner sees and changes them, before the draw; the id is
      // "{a}_{b}" with a < b, so each pair exists once.
      match /exclusions/{pairId} {
        allow read: if signedIn()
          && get(drawPath(drawId)).data.ownerUuid == request.auth.uid;

        allow create: if signedIn()
          && isOwnerBeforeDraw(drawId)
          && request.resource.data.keys().hasOnly(['a', 'b'])
          && request.resource.data.a is string
          && request.resource.data.b is string
          && request.resource.data.a < request.resource.data.b
          && pairId == request.resource.data.a + '_' + request.resource.data.b
          && request.resource.data.a in get(drawPath(drawId)).data.participantUuids
          && request.resource.data.b in get(drawPath(drawId)).data.participantUuids;

        allow delete: if signedIn()
          && (isOwnerBeforeDraw(drawId) || isDeletingDraw(drawId));
      }

      // Draw result: one document per giver, readable only by that giver.
      // Written once by the owner, in the same batch that moves the draw from
      // WAITING_FOR_DRAW to DRAWED, and never changed afterwards.
      match /assignments/{giverUid} {
        allow get: if signedIn() && request.auth.uid == giverUid;

        allow create: if signedIn()
          && get(drawPath(drawId)).data.ownerUuid == request.auth.uid
          && get(drawPath(drawId)).data.status == 'WAITING_FOR_DRAW'
          && getAfter(drawPath(drawId)).data.status == 'DRAWED'
          && request.resource.data.keys().hasOnly(['toUuid'])
          && request.resource.data.toUuid is string
          && request.resource.data.toUuid != giverUid
          && giverUid in getAfter(drawPath(drawId)).data.participantUuids
          && request.resource.data.toUuid in getAfter(drawPath(drawId)).data.participantUuids;
      }
    }

    function statValue(field) {
      return resource == null ? 0 : resource.data.get(field, 0);
    }

    // +1 draw, only in the batch that creates draw lastDrawId.
    function isCountingNewDraw() {
      let d = request.resource.data;
      return d.drawsCount == statValue('drawsCount') + 1
        && d.get('winnersCount', 0) == statValue('winnersCount')
        && !exists(drawPath(d.lastDrawId))
        && getAfter(drawPath(d.lastDrawId)).data.ownerUuid == request.auth.uid;
    }

    // +N winners, only in the batch that starts draw lastDrawId (N participants).
    function isCountingStartedDraw() {
      let d = request.resource.data;
      return d.get('drawsCount', 0) == statValue('drawsCount')
        && get(drawPath(d.lastDrawId)).data.status == 'WAITING_FOR_DRAW'
        && getAfter(drawPath(d.lastDrawId)).data.status == 'DRAWED'
        && d.winnersCount == statValue('winnersCount')
          + getAfter(drawPath(d.lastDrawId)).data.participantUuids.size();
    }

    match /appData/stats {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['drawsCount', 'winnersCount', 'lastDrawId'])
        && request.resource.data.lastDrawId is string
        && (isCountingNewDraw() || isCountingStartedDraw());
    }

    // Messages to the author. One document per user per UTC day
    // ({uid}_{year}-{month}-{day}), create-only: this is the daily limit.
    // Only the author reads them (in the Firebase console).
    match /messages/{messageId} {
      allow get: if signedIn()
        && messageId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}');

      allow create: if signedIn()
        && messageId == request.auth.uid + '_' + string(request.time.year())
          + '-' + string(request.time.month()) + '-' + string(request.time.day())
        && request.resource.data.keys().hasOnly(['userUid', 'userName', 'message', 'date'])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.userName == request.auth.token.get('name', request.auth.uid)
        && isString(request.resource.data.message, 1000)
        && request.resource.data.message.size() > 0
        && request.resource.data.date == request.time;
    }
  }
}
