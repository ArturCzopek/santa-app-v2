# Used by `yarn dev:emulators`: runs the app against local Firebase emulators.
# Fake values only - the emulators accept anything for a demo-* project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-santa-app
VITE_FIREBASE_APP_ID=demo-app-id
VITE_APP_URL=http://localhost:5173
