# Copy to .env.staging (not committed) and fill in the web app config of the
# dev Firebase project: Firebase console -> Project settings -> General ->
# Your apps -> SDK setup and configuration -> Config.
# Then: npm run dev:staging (real Google sign-in against the dev project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_APP_URL=http://localhost:5173
