{
  "name": "santa-app-v2",
  "version": "1.0.0",
  "homepage": "https://arturczopek.github.io/santa-app-v2",
  "main": "main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-santa-app",
    "dev:emulators": "vite --mode emulators",
    "test": "firebase emulators:exec --only firestore --project demo-santa-app \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^5.10.1",
    "@mui/material": "^5.10.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "i18next": "^24.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.4.3",
    "react-snowfall": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "globals": "^17.12.0",
    "prettier": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "author": "Artur Czopek",
  "license": "MIT",
  "description": "A Christmas-themed draw and messaging app using React, Firebase, Material UI, and Firebase Authentication.",
  "keywords": [
    "react",
    "firebase",
    "material-ui",
    "christmas",
    "draw",
    "app"
  ]
}
